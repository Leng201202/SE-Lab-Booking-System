<mxfile host="app.diagrams.net" modified="2026-10-06T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="student-booking-flow" name="Student requests a PC">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Start -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Step 1-3: form steps -->
        <mxCell id="review" value="Student reviews PC inventory / availability calendar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="choose" value="Chooses an available interval: one-day lab, or multi-day remote" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="230" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fill" value="Fills the form: PC, dates/times, purpose, optional course" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="340" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="submit" value="Submits booking request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="450" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Decision guards, matching create_booking's real validation order -->
        <mxCell id="d1" value="Has an application profile?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="550" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Has an assigned, eligible Advisor?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="680" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Selected PC exists and is available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="810" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Start date/time valid, purpose &#8805; 5 chars?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="940" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="Overlaps an existing active booking on that PC?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="1080" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Reject sink -->
        <mxCell id="reject" value="Request rejected &#8212; actionable error shown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="800" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Success path -->
        <mxCell id="created" value="Booking row created, status = pending_technician" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="1210" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="detail" value="Student sees request detail and approval progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="1310" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="1420" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Edges: main spine -->
        <mxCell id="e-start-review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="start" target="review">
          <mxGeometry relative="1" as="geometry" />
