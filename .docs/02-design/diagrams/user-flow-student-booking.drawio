        <mxCell id="e-d4-reject" value="invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="d4" target="reject">
          <mxGeometry relative="1" as="geometry" />
