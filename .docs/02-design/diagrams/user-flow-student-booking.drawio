        <mxCell id="e-detail-end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="detail" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: reject branches -->
        <mxCell id="e-d1-reject" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="d1" target="reject">
